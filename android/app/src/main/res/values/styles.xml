<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Buttons -->
    <style name="Widget.HanoiLens.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HanoiLens.LabelL</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HanoiLens.Pill</item>
    </style>
    <style name="Widget.HanoiLens.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HanoiLens.LabelL</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HanoiLens.Pill</item>
    </style>
    <style name="Widget.HanoiLens.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HanoiLens.LabelL</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HanoiLens.Pill</item>
        <item name="strokeColor">@color/outline</item>
    </style>
    <style name="Widget.HanoiLens.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.HanoiLens.LabelL</item>
    </style>

    <style name="Widget.HanoiLens.Button.Large" parent="Widget.HanoiLens.Button">
        <item name="android:minHeight">@dimen/hl_button_height_l</item>
    </style>
    <style name="Widget.HanoiLens.Button.Small" parent="Widget.HanoiLens.Button">
        <item name="android:minHeight">@dimen/hl_button_height_s</item>
    </style>
    <style name="Widget.HanoiLens.Button.Destructive" parent="Widget.HanoiLens.Button">
        <item name="backgroundTint">@color/hl_error</item>
        <item name="android:textColor">@color/hl_on_error</item>
    </style>
    
    <!-- Cards -->
    <style name="Widget.HanoiLens.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container_low</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HanoiLens.Large</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.HanoiLens.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HanoiLens.Large</item>
    </style>

    <!-- Chips / status badges -->
    <style name="Widget.HanoiLens.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/secondary_container</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- Bottom navigation (custom item_bottom_nav.xml) -->
    <style name="Widget.HanoiLens.BottomNav.Pill" parent="">
        <item name="android:background">@color/nav_pill_bg</item>
        <item name="android:elevation">8dp</item>
    </style>
    <style name="Widget.HanoiLens.BottomNav.Label" parent="TextAppearance.HanoiLens.LabelS">
        <item name="android:textColor">@color/nav_inactive_text</item>
    </style>
</resources>
